{
  "name": "@clickety-clacks/tightbeam-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Embeddable single-session Tightbeam conversation surface",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": ["dist", "README.md", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:chat-server": "vite build --config examples/vite.config.ts --outDir ../dist/chat-server/public --emptyOutDir",
    "package:chat-release": "node scripts/package-chat-release.mjs",
    "update:chat-release": "node scripts/update-chat-release.mjs",
    "release:assert-tag": "node scripts/assert-chat-release-ref.mjs",
    "release:publish": "node scripts/publish-chat-release.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "example": "vite --config examples/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.3"
  }
}
