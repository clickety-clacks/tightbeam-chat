[Unit]
Description=Tightbeam Chat private server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/tightbeam-chat/current
EnvironmentFile=%h/.config/tightbeam-chat/server.env
ExecStart=/usr/bin/env node server/chat-server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
